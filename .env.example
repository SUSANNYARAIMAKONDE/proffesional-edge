# Copy to .env on the server and fill in. NEVER commit .env or share it publicly.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=generate-a-long-random-string
DJANGO_ALLOWED_HOSTS=professionaledge.co.zw,www.professionaledge.co.zw
CSRF_TRUSTED_ORIGINS=https://professionaledge.co.zw,https://www.professionaledge.co.zw
SITE_URL=https://www.professionaledge.co.zw
ADMIN_URL=office-9f3k/            # change from the default 'admin/' to reduce bot traffic; keep trailing slash

# PostgreSQL (leave DB_NAME empty to use SQLite - development only)
DB_NAME=professional_edge
DB_USER=pe_user
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Email (use a reliable provider; set up SPF/DKIM for the domain)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Professional Edge <no-reply@professionaledge.co.zw>
STAFF_NOTIFY_EMAIL=            # owner-approved inbox for new enquiries
