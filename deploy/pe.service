# /etc/systemd/system/pe.service   (adjust paths/user)
[Unit]
Description=Professional Edge (gunicorn)
After=network.target postgresql.service

[Service]
User=pe
Group=www-data
WorkingDirectory=/srv/professional_edge
EnvironmentFile=/srv/professional_edge/.env
ExecStart=/srv/professional_edge/venv/bin/gunicorn config.wsgi:application --workers 3 --bind unix:/run/pe.sock --access-logfile - --error-logfile -
Restart=on-failure
RuntimeDirectory=pe

[Install]
WantedBy=multi-user.target
